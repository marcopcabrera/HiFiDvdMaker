<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.marcopcabrera.HiFiDvdMaker</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>HiFi DVD Maker</name>
  <summary>Create high-fidelity audio DVDs from your music collection</summary>

  <description>
    <p>
      HiFi DVD Maker is a modern application built with GTK4 and Libadwaita designed to author and create high-fidelity audio DVDs from your music collection.
    </p>
    <p>
      Key features include:
    </p>
    <ul>
      <li>High-Fidelity Audio Support: Author uncompressed, CD-quality (LPCM) audio DVDs.</li>
      <li>AC3 Compression Option: Optional Dolby Digital (AC3) encoding support for space savings.</li>
      <li>Multiple Output Formats: Export as an ISO image or a VIDEO_TS folder.</li>
      <li>Standalone DVD Navigation: Standard DVD tracks that allow skipping forward and backward on any player.</li>
      <li>Compilation Cover Art: Upload custom cover art for your music compilation.</li>
    </ul>
  </description>

  <developer id="io.github.marcopcabrera">
    <name>Marco P. Cabrera</name>
  </developer>

  <!-- URLs del proyecto -->
  <url type="homepage">https://github.com/marcopcabrera/HiFiDvdMaker</url>
  <url type="vcs-browser">https://github.com/marcopcabrera/HiFiDvdMaker</url>
  <url type="bugtracker">https://github.com/marcopcabrera/HiFiDvdMaker/issues</url>

  <translation type="gettext">hifidvdmaker</translation>
  <launchable type="desktop-id">io.github.marcopcabrera.HiFiDvdMaker.desktop</launchable>
  <content_rating type="oars-1.1" />

  <!-- Colores de marca -->
  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1e5b9e</color>
  </branding>

  <!-- Capturas de pantalla -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/marcopcabrera/HiFiDvdMaker/main/data/screenshots/main.png</image>
      <caption>Main application interface</caption>
    </screenshot>
  </screenshots>

  <!-- Historial de versiones -->
  <releases>
    <release version="0.1.0" date="2026-09-28">
      <description>
        <p>Initial public release.</p>
      </description>
    </release>
  </releases>
</component>
