{
    "app-id" : "io.github.marcopcabrera.HiFiDvdMaker",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "46",
    "sdk" : "org.gnome.Sdk",
    "command" : "hifidvdmaker",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=host",
        "--device=all",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.portal.Inhibit"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "libdvdread",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://code.videolan.org/videolan/libdvdread.git",
                    "branch" : "master"
                }
            ]
        },
        {
            "name" : "dvdauthor",
            "buildsystem" : "autotools",
            "autogen-cmd" : "autoreconf -fiv",
            "make-args" : [
                "SUBDIRS=src"
            ],
            "make-install-args" : [
                "SUBDIRS=src"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/ldo/dvdauthor.git",
                    "branch" : "master"
                }
            ]
        },
        {
            "name" : "cdrkit",
            "buildsystem" : "cmake",
            "config-opts" : [
                "-DCMAKE_INSTALL_PREFIX=/app",
                "-DCMAKE_C_FLAGS=-fcommon"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/Distrotech/cdrkit.git",
                    "branch" : "distrortech-cdrkit"
                }
            ]
        },
        {
            "name" : "hifidvdmaker",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}