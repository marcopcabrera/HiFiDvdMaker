msgstr "VIDEO_TS egitura sortzen dvdauthor-ekin..."

#: src/dvd_engine.py:826
#, python-brace-format
msgid ""
"dvdauthor falló al construir la estructura:\n"
"{detalle}"
msgstr ""
"dvdauthor-ek huts egin du egituran:\n"
"{detalle}"

