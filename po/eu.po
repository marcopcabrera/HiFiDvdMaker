msgstr "Ez da azala aurkitu: {ruta}"

#: src/dvd_engine.py:762 src/dvd_engine.py:887
msgid "No se especificaron archivos de audio."
msgstr "Ez da audio fitxategirik zehaztu."

#: src/dvd_engine.py:779
msgid "Optimizando imagen de portada..."
msgstr "Azalaren irudia optimizatzen..."

#: src/dvd_engine.py:799
