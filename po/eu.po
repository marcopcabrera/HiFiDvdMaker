#: data/io.github.marcopcabrera.HiFiDvdMaker.desktop.in:2
#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:7
msgid "HiFi DVD Maker"
msgstr "HiFi DVD Maker"

#: data/io.github.marcopcabrera.HiFiDvdMaker.desktop.in:9
msgid "Audio;DVD;Grabador;Grabadora;GTK;"
msgstr "Audioa;DVD;Grabagailua;GTK;"

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:8
msgid "Crea DVDs de audio de alta fidelidad a partir de tu colección de música"
msgstr "Sortu kalitate handiko audio DVDak zure musika bildumatik"

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:11
msgid ""
"HiFi DVD Maker es una aplicación moderna basada en GTK4 / Libadwaita diseñada para Linux "
"que permite autorizar y crear fácilmente DVDs de audio de alta fidelidad con portadas personalizadas "
"para tu compilación musical, listos para grabar en formato físico o reproducir directamente."
msgstr ""
"HiFi DVD Maker GTK4 / Libadwaita-n oinarritutako Linuxerako aplikazio modernoa da, "
"zure musikarentzat azal pertsonalizatuekin kalitate handiko audio DVDak "
"erraz sortzeko eta zuzenean erreproduzitzeko edo grabatzeko gaitasuna duena."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:14
msgid "Las características principales incluyen:"
msgstr "Ezaugarri nagusiak honako hauek dira:"

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:18
msgid ""
"Soporte de audio de alta fidelidad: Autoría de DVDs de audio sin compresión con calidad de CD (LPCM)."
msgstr ""
"Kalitate handiko audioa: Konpresiorik gabeko audio DVDak CD kalitatearekin (LPCM)."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:19
msgid "Opción de compresión AC3: Soporte de codificación opcional Dolby Digital (AC3)."
msgstr "AC3 konpresio aukera: Dolby Digital (AC3) kodetzeko aukera."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:20
msgid ""
"Múltiples formatos de salida: Exporta como ISO o estructura VIDEO_TS, lista para grabar en un disco DVD."
msgstr ""
"Irteera formatu anitzak: Eksportatu ISO edo VIDEO_TS gisa, DVDan grabatzeko prest."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:21
msgid ""
"Navegación de DVD estándar: Genera pistas y capítulos de DVD estándar para reproductores de DVD domésticos o de coche."
msgstr ""
"DVD nabigazio estandarra: Etxeko zein autoko DVD erreproduzitzaileentzako pistak sortzen ditu."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:22
msgid "Portada de la compilación: Muestra portadas personalizadas en pantalla."
msgstr "Bildumaren azala: Erakutsi azal pertsonalizatuak pantailan."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:23
msgid "Soporte multilingüe: Disponible en 12 idiomas."
msgstr "Hizkuntza anitzeko laguntza: 12 hizkuntzatan eskuragarri."

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:28
msgid "Marco P. Cabrera"
msgstr "Marco P. Cabrera"

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:50
msgid "Interfaz principal de la aplicación"
msgstr "Aplikazioaren interfaze nagusia"

#: data/io.github.marcopcabrera.HiFiDvdMaker.metainfo.xml.in:58
msgid "Lanzamiento público inicial."
msgstr "Hasierako bertsio publikoa."

#: data/io.github.marcopcabrera.HiFiDvdMaker.gschema.xml:7
#: src/preferences-dialog.ui:45
msgid "Idioma de la interfaz"
msgstr "Interfazearen hizkuntza"

#: data/io.github.marcopcabrera.HiFiDvdMaker.gschema.xml:8
msgid ""
"Código del idioma (ej. 'es', 'de', 'ja') or 'system' para usar el del sistema "
"operativo."
msgstr ""
"Hizkuntza kodea (adib. 'eu', 'es', 'de') edo 'system' sistemarena erabiltzeko."

#: data/io.github.marcopcabrera.HiFiDvdMaker.gschema.xml:13
msgid "Formato de audio predeterminado"
msgstr "Nabaritutako audio formatua"

#: data/io.github.marcopcabrera.HiFiDvdMaker.gschema.xml:18
#: src/preferences-dialog.ui:60
