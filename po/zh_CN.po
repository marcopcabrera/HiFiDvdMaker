#, python-brace-format
msgid ""
"Fallo al compilar la ISO con {herramienta}.\n"
"Detalle:\n"
"{detalle}"
msgstr ""
"使用 {herramienta} 构建 ISO 失败。\n"
"细节：\n"
"{detalle}"

