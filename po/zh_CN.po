msgid "Optimizando imagen de portada..."
msgstr "正在优化封面图像..."

#: src/dvd_engine.py:799
msgid "Compilando estructura VIDEO_TS con dvdauthor..."
msgstr "正在使用 dvdauthor 构建 VIDEO_TS..."

#: src/dvd_engine.py:826
#, python-brace-format
msgid ""
"dvdauthor falló al construir la estructura:\n"
"{detalle}"
msgstr ""
"dvdauthor 构建失败：\n"
"{detalle}"

