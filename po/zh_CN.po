msgid "No hay suficiente espacio libre en disco para completar la operación."
msgstr "磁盘空间不足，无法完成操作。"

#: src/dvd_engine.py:432
#, python-brace-format
msgid "Fallo al optimizar la portada: {error}"
msgstr "优化封面失败：{error}"

#: src/dvd_engine.py:563
#, python-brace-format
msgid "Codificando Pista {actual}/{total} ({formato})"
msgstr "正在编码音轨 {actual}/{total} ({formato})"

#: src/dvd_engine.py:641
#, python-brace-format
msgid ""
"Fallo al codificar la pista {pista_num}:\n"
"{error}"
msgstr ""
"编码音轨 {pista_num} 失败：\n"
"{error}"

#: src/dvd_engine.py:652
msgid "Escribiendo tabla de capítulos nativa..."
msgstr "正在写入章节表..."

#: src/dvd_engine.py:704
msgid "No se encontró 'genisoimage' ni 'mkisofs' real en el sistema."
msgstr "未找到 'genisoimage' 或 'mkisofs'。"

