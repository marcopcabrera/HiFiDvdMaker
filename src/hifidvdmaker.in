import os
import sys
import signal
import locale
import gettext

# --- 1. IDENTIFICACIÓN DE PROCESO ANTES DE IMPORTAR GIO/GTK ---
APP_ID = 'io.github.marcopcabrera.HiFiDvdMaker'
os.environ['GDK_APP_ID'] = APP_ID

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('hifidvdmaker', localedir)
locale.textdomain('hifidvdmaker')
gettext.bindtextdomain('hifidvdmaker', localedir)
gettext.textdomain('hifidvdmaker')

if __name__ == '__main__':
    import gi
    from gi.repository import GLib

    # Establecer la identidad C de la aplicación antes de cargar ningún recurso
    GLib.set_prgname(APP_ID)


    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'hifidvdmaker.gresource'))
    resource._register()

    from hifidvdmaker import main
    sys.exit(main.main(VERSION))